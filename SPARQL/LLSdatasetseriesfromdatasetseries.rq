PREFIX dcat:      <http://www.w3.org/ns/dcat#>
PREFIX dct:       <http://purl.org/dc/terms/>
PREFIX foaf:      <http://xmlns.com/foaf/0.1/>
PREFIX prov:      <http://www.w3.org/ns/prov#>
PREFIX vcard:     <http://www.w3.org/2006/vcard/ns#>
PREFIX dcatap:    <http://data.europa.eu/r5r/>
PREFIX health:    <http://healthdataportal.eu/ns/health#>
PREFIX owl:       <http://www.w3.org/2002/07/owl#>

CONSTRUCT {

  #################################################################
  # DATASET
  #################################################################

  ?DatasetSeries
      a dcat:DatasetSeries ;
      dct:title ?title ;
      dct:description ?description ;
      dct:identifier ?identifier ;
      prov:Attribution ?attribution ;
      dct:issued ?issued ;
      dct:modified ?now ;
      dct:accessRights ?accessRights ;
      dct:language ?language ;
      dcat:theme ?theme ;
      dcat:keyword ?keyword ;
      dcat:contactPoint ?contactPoint ;
      foaf:page ?page ;
      dct:isReferencedBy ?publication ;
      dct:creator ?lumc ;
      dct:publisher ?lumc ;
      dcatap:applicableLegislation
          <http://data.europa.eu/eli/reg/2025/327/oj> ;
      prov:qualifiedAttribution ?attribution ;
      dcat:keyword "epidemiology"@en , "epidemiologie"@nl .

  #################################################################
  # LUMC ORGANIZATION
  #################################################################

  ?lumc
      a foaf:Agent ;
      dct:identifier "https://ror.org/05xvt9f17" ;
      foaf:name
          "Leiden University Medical Center"@en ,
          "Leids Universitair Medisch Centrum"@nl ;
      health:publisherNote
          "Het Leids Universitair Medisch Centrum (LUMC) is een universitair medisch centrum (umc). Wij hebben een actieve en innovatieve rol in de gezondheidszorg: regionaal, nationaal en internationaal. Dat is terug te zien in onze 3 kerntaken: patientenzorg, wetenschappelijk onderzoek en het opleiden van zorgprofessionals (onderwijs)."@nl ;
      health:publisherType
          <http://purl.org/adms/publishertype/Academia-ScientificOrganisation> ;
      dct:spatial
          <http://publications.europa.eu/resource/authority/country/NLD> ;
      foaf:homepage
          <https://www.lumc.nl/> ;
      foaf:mbox
          <mailto:lucid@lumc.nl> .

  #################################################################
  # QUALIFIED ATTRIBUTIONS
  #################################################################

  ?attribution
      a prov:Attribution ;
      prov:agent ?author ;
      dcat:hadRole ?role .

  ?author
      a foaf:Agent ;
      dct:identifier ?authorId ;
      foaf:name ?authorName .

  ?author foaf:homepage ?authorHomepage .
  ?author foaf:mbox ?authorEmail .

  #################################################################
  # CONTACT POINT
  #################################################################

  ?contactPoint
      a vcard:Kind ;
      vcard:fn ?contactName ;
      vcard:hasEmail ?contactEmail .

}
WHERE {

  ?dataset a dcat:DatasetSeries .
  BIND(?dataset AS ?sourcedataset)

  BIND( IRI("https://fdp.lumc.nl/dataset/new")
    AS ?dataset)

  BIND(NOW() AS ?now)

  BIND(
      IRI(CONCAT(STR(?dataset), "/organization/lumc"))
      AS ?lumc
  )

  OPTIONAL { ?sourcedataset dct:title ?title }
  OPTIONAL { ?sourcedataset dct:description ?description }
  OPTIONAL { ?sourcedataset dct:identifier ?identifier }
  OPTIONAL { ?sourcedataset dct:issued ?issued }

  OPTIONAL { ?sourcedataset dct:accessRights ?accessRights }
  OPTIONAL { ?sourcedataset dct:language ?language }
  OPTIONAL { ?sourcedataset dcat:theme ?theme }
  OPTIONAL { ?sourcedataset dcat:keyword ?keyword }

  OPTIONAL { ?sourcedataset dct:conformsTo ?conformsTo }
  OPTIONAL { ?sourcedataset foaf:page ?page }
  OPTIONAL { ?sourcedataset dct:isReferencedBy ?publication }

  OPTIONAL {
      ?sourcedataset dcat:contactPoint ?contactPoint .

      OPTIONAL { ?contactPoint vcard:fn ?contactName }
      OPTIONAL { ?contactPoint vcard:hasEmail ?contactEmail }
  }

  OPTIONAL {
      # set qualified attribution based on creator property as this was previously used to indicate the author of the dataset
      ?sourcedataset dct:creator ?author .
      ?author
          dct:identifier ?authorId ;
          foaf:name ?authorName .

      OPTIONAL { ?author foaf:homepage ?authorHomepage }
      OPTIONAL { ?author foaf:mbox ?authorEmail }
      # bind attribution IRI based on dataset and author ORCID ID
      BIND(
          IRI(
              CONCAT(
                  STR(?dataset),
                  "/attribution/",
                  ENCODE_FOR_URI(
                      REPLACE(
                          STR(?authorId),
                          "^https://orcid.org/",
                          ""
                      )
                  )
              )
          )
          AS ?attribution
      )
      # bind role based on ORCID ID (example: PI vs. collaborator)
      BIND(
          IF(
              ?authorId IN (
                  "EXAMPLE_ORCID_1"
              ),
              <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#PrincipalInvestigator>,
              <https://standards.iso.org/iso/19115/resources/Codelists/gml/CI_RoleCode.xml#Collaborator>
          )
          AS ?role
      )
            
      ?attribution
          a prov:Attribution ;
          prov:agent ?author ;
          dcat:hadRole ?role .
  }
}