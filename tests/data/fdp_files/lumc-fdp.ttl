<https://fdp.lumc.nl/dataset/3586562c-63d2-4e4b-9ac6-79e5fbab6ae1> a dcat:Dataset ;
    rdfs:label "Nightingale" ;
    dcterms:accessRights <https://fdp.lumc.nl/dataset/3586562c-63d2-4e4b-9ac6-79e5fbab6ae1#accessRights> ;
    dcterms:conformsTo <https://fdp.lumc.nl/profile/2f08228e-1789-40f8-84cd-28e3288c3604> ;
