<https://fdp.lumc.nl/dataset/2a88699d-4c81-4407-9357-070c227bc7c7> a dcat:Dataset ;
    rdfs:label "LLS IOP2 Participant info" ;
    dcterms:accessRights <https://fdp.lumc.nl/dataset/2a88699d-4c81-4407-9357-070c227bc7c7#accessRights> ;
    dcterms:conformsTo <https://fdp.lumc.nl/profile/2f08228e-1789-40f8-84cd-28e3288c3604> ;
