<https://fdp.lumc.nl/dataset/0d7217e1-0119-4fdc-8bc7-13a0d3eab0fc> a dcat:Dataset ;
    rdfs:label "Castor Medische voorgeschiedenis CCI" ;
    dcterms:accessRights <https://fdp.lumc.nl/dataset/0d7217e1-0119-4fdc-8bc7-13a0d3eab0fc#accessRights> ;
